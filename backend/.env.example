# Copiar a .env y ajustar. .env no se commitea.
DATABASE_URL=postgresql+psycopg://trackfolio:trackfolio@localhost:5435/trackfolio

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=cambiar-esto-en-produccion

ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Asistente de ofertas (opcional). Sin esto, la app funciona igual y solo el asistente se apaga.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
